#!/bin/bash
# ATOM engine host bootstrap.
#
# Deliberately minimal: it installs the runtime and the proxy, and leaves the
# application to a git checkout managed by the deployment procedure. Baking the
# application into user_data would make every code change an instance
# replacement, and instance replacement touches Elastic IPs.
set -euo pipefail

exec > >(tee /var/log/atom-bootstrap.log) 2>&1
echo "ATOM bootstrap starting at $(date -Is)"

dnf -y update
dnf -y install python3.11 python3.11-pip git squid awscli

install -d -m 0755 -o root -g root /opt/atom /etc/atom
install -d -m 0755 /var/log/atom

cat > /etc/atom/config.toml <<'CONF'
# Non-secret configuration only. This file would be safe to publish:
# broker tokens live in SSM and the Supabase key is fetched at startup.
env = "${env}"
region = "${region}"
log_dir = "/var/log/atom"
idle_shutdown_minutes = ${idle_shutdown_minutes}
investor_count = ${investor_count}
CONF

# ---------------------------------------------------------------- proxies
# One forward-proxy port per investor, each bound to that investor's own source
# address, so the broker sees the Elastic IP registered for that investor and no
# other (D-005/D-173).
#
# WHY SQUID AND NOT NGINX. The design named nginx's stream module as the starting
# approach and tinyproxy as the fallback "if HTTPS CONNECT handling through
# stream proves awkward" (STATIC-IP-AND-PROXY.md 2.2). It is not awkward, it is
# impossible: the stream module is a TCP proxy to a configured upstream and does
# not implement the CONNECT verb, so it cannot learn where a client wants to go.
# Every broker call is HTTPS, so every broker call is a CONNECT.
#
# Squid rather than the documented tinyproxy fallback for one reason: tinyproxy
# binds a single outbound address per process, so N investors means N daemons, N
# unit files and N ways to get the pairing wrong. Squid's tcp_outgoing_address
# takes an ACL, so the port-to-source-address mapping is one table in one file --
# which is the thing that must be right, and is therefore the thing that should
# be readable in one place.
#
# Every port listens on 127.0.0.1 only. An open forward proxy reachable from the
# internet is found and abused within hours.
SQUID_CONF=/etc/squid/squid.conf
cat > "$SQUID_CONF" <<'CONF'
# Managed by ATOM user_data. Hand edits are lost on instance replacement.
acl localnet src 127.0.0.1/32
acl SSL_ports port 443
acl Safe_ports port 443
acl CONNECT method CONNECT

# 443 only, CONNECT only, from this host only.
#
# Port 80 is deliberately NOT in Safe_ports. Every broker API ATOM speaks to is
# HTTPS, so nothing legitimate leaves here in plaintext -- and a proxy that will
# forward cleartext HTTP is a ready-made exfiltration channel for anything that
# gets onto this host, one that leaves the instance from the very address the
# brokers trust.
#
# Verified after deployment: a plaintext request through this proxy returns 403.
http_access deny !Safe_ports
http_access deny !CONNECT
http_access deny CONNECT !SSL_ports
http_access allow localnet
http_access deny all

# No caching. A cached broker response served to a later call would be a wrong
# price or a stale order status presented as current.
cache deny all
cache_store_log none
access_log stdio:/var/log/squid/access.log

# Do not announce the proxy or the client to the broker.
via off
forwarded_for delete
request_header_access X-Forwarded-For deny all

dns_v4_first on
shutdown_lifetime 5 seconds
CONF

%{ for i in range(investor_count) ~}
cat >> "$SQUID_CONF" <<CONF
# ---- investor ${i + 1}: port $((3128 + ${i})) egresses from 10.0.1.$((10 + ${i}))
# myport matches the numeric local port. myportname would match an http_port
# name= label, which none of these have -- it would compile and match nothing,
# leaving tcp_outgoing_address inert and every investor egressing from the
# primary address. Silently, and identically for all of them.
http_port 127.0.0.1:$((3128 + ${i}))
acl investor_${i} myport $((3128 + ${i}))
tcp_outgoing_address 10.0.1.$((10 + ${i})) investor_${i}
CONF
%{ endfor ~}

install -d -m 0750 -o squid -g squid /var/log/squid
# Fail fast and loudly: a syntax error here means every broker call leaves from
# the wrong address, which Dhan punishes with a seven-day IP lock.
squid -k parse
# --now, because `enable` only arms the unit for the NEXT boot. Without it squid
# is installed, configured, validated and not running, and the first broker call
# of the day fails to connect to a proxy that is merely scheduled to exist.
systemctl enable --now squid

# ------------------------------------------------------------ idle shutdown
cat > /usr/local/bin/atom-idle-check <<'IDLE'
#!/bin/bash
# Stop the instance after a period with no console session and no running run.
# The engine requests shutdown itself after a completed run; this is the backstop
# for a crashed or abandoned session.
set -euo pipefail
THRESHOLD_MIN=${idle_shutdown_minutes}
# /run/atom is the engine's RuntimeDirectory, owned by the unprivileged atom
# user. A marker in root-owned /var/run could never be touched by the engine,
# so console use would not count as activity and the instance would stop an
# hour after boot however busy it was.
MARKER=/run/atom/last-activity
[ -f "$MARKER" ] || date +%s > "$MARKER"
LAST=$(cat "$MARKER")
NOW=$(date +%s)
IDLE_MIN=$(( (NOW - LAST) / 60 ))
if [ "$IDLE_MIN" -ge "$THRESHOLD_MIN" ]; then
  # The doubled dollar escapes the interpolation. templatefile expands EVERY
  # dollar-brace in this file, comments included, regardless of shell quoting --
  # so a shell variable written with braces is read as a Terraform variable and
  # fails the whole template. A single-quoted heredoc protects these from the
  # shell, not from Terraform.
  logger -t atom "idle $${IDLE_MIN}m >= $${THRESHOLD_MIN}m, requesting shutdown"
  shutdown -h now
fi
IDLE
chmod 0755 /usr/local/bin/atom-idle-check

cat > /etc/systemd/system/atom-idle.service <<'UNIT'
[Unit]
Description=ATOM idle shutdown check
[Service]
Type=oneshot
ExecStart=/usr/local/bin/atom-idle-check
UNIT

cat > /etc/systemd/system/atom-idle.timer <<'UNIT'
[Unit]
Description=Run the ATOM idle check every 5 minutes
[Timer]
OnBootSec=10min
OnUnitActiveSec=5min
[Install]
WantedBy=timers.target
UNIT

systemctl daemon-reload
systemctl enable --now atom-idle.timer

echo "ATOM bootstrap finished at $(date -Is)"
echo "Next: deploy the application per docs/02-infrastructure/DEPLOYMENT.md"
