[Unit]
Description=ATOM engine and console
Documentation=https://github.com/hardik-05/atom/blob/HEAD/docs/02-infrastructure/DEPLOYMENT.md
After=network-online.target squid.service
Wants=network-online.target

[Service]
Type=simple
User=atom
Group=atom
EnvironmentFile=/etc/atom/atom.env
WorkingDirectory=/opt/atom/current
# One worker, deliberately: background jobs run in-process, and two workers
# would each keep a job list the other cannot see.
ExecStart=/opt/atom/current/.venv/bin/uvicorn atom.web.main:app \
    --host 127.0.0.1 --port 8000 --workers 1 \
    --proxy-headers --forwarded-allow-ips 127.0.0.1 \
    --no-server-header --log-level info
Restart=on-failure
RestartSec=5

# /run/atom holds the activity marker the idle-shutdown timer reads.
RuntimeDirectory=atom
RuntimeDirectoryPreserve=yes

# The engine needs to read its own release, write its logs, and nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/log/atom /run/atom

[Install]
WantedBy=multi-user.target
