# Managed by deploy/install.sh. Hand edits are overwritten on the next deploy.
#
# Caddy terminates TLS for the console and obtains its own certificate from
# Let's Encrypt — HTTP-01 on port 80 or TLS-ALPN-01 on 443, whichever answers —
# and renews it without a cron job. Everything else is a reverse proxy to the
# engine on localhost; the engine itself never listens on a public address.

__PUBLIC_HOST__ {
	encode zstd gzip

	reverse_proxy 127.0.0.1:8000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Scripts and API calls from this origin only. Fonts come from Google;
		# inline style attributes are allowed because the charting library sets them.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
